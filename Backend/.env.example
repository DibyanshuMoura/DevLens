# Required -------------------------------------------------------------------
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=devlens
GROQ_API_KEY=your_groq_api_key

# Optional -------------------------------------------------------------------
PORT=3000
GROQ_MODEL=openai/gpt-oss-120b

# GitHub OAuth — required for sign-in, history and role matching.
# Create an app at https://github.com/settings/developers and set the
# callback URL to <APP_URL>/auth/github/callback.
# Without these the app still runs; sign-in just reports "not configured".
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
JWT_SECRET=

# Public origins. Must be HTTPS in production — an http:// FRONTEND_URL makes
# the OAuth callback redirect from an HTTPS page to HTTP, which the browser
# blocks as mixed content, so the token never arrives.
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173